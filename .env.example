# Secure Translate — Environment Configuration
# Copy this file to .env and fill in your values.

# --- App ---
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./secure_translate.db

# --- Redis (for Celery task queue) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Translation Engine ---
# Options: "gemini", "azure", "google"
DEFAULT_TRANSLATION_ENGINE=gemini

# Gemini API (default engine — cheapest, 1M context window)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Azure Translator (best free tier — 2M chars/month free)
AZURE_TRANSLATOR_KEY=your-azure-translator-key
AZURE_TRANSLATOR_REGION=your-azure-region
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Google Cloud Translation v3
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
GOOGLE_PROJECT_ID=your-gcp-project-id

# --- OCR ---
OCR_LANGUAGES=en,ch
OCR_USE_GPU=false

# --- Processing ---
MAX_FILE_SIZE_MB=100
MAX_PAGES=1000
OCR_DPI=300
CHUNK_SIZE_CHARS=4000
